---
export interface Props {
  name: string;
  jobTitle: string;
  email: string;
  github?: string;
  linkedin?: string;
  sameAs?: string[];
}

const { name, jobTitle, email, github, linkedin, sameAs = [] } = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  jobTitle,
  email: `mailto:${email}`,
  url: "https://sjrah.net/",
  description:
    "Backend and data engineer building reliable backend systems, AI tools, and data pipelines with Python, Go, and TypeScript.",
  sameAs: [
    github,
    linkedin,
    ...sameAs,
  ].filter(Boolean),
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
