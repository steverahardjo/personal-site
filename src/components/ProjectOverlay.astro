---
export interface Props {
  title: string;
  tagline: string;
  summary: string;
  tags: string[];
  github?: string;
  features?: string[];
  workflow?: string[];
  stack?: string[];
}

const { title, tagline, summary, tags, github, features, workflow, stack } = Astro.props;
---

<section class="relative overflow-hidden border border-[var(--border)] bg-[var(--surface-low)]">
  <div aria-hidden="true" class="absolute inset-0">
    <div
      class="absolute -top-24 -right-20 w-96 h-96 rounded-full blur-3xl"
      style="background: color-mix(in srgb, var(--accent) 32%, transparent)"
    />
    <div
      class="absolute -bottom-32 -left-24 w-[30rem] h-[30rem] rounded-full blur-3xl"
      style="background: color-mix(in srgb, var(--accent-secondary) 36%, transparent)"
    />
    <div
      class="absolute top-1/3 left-1/2 w-72 h-72 rounded-full blur-2xl opacity-60"
      style="background: color-mix(in srgb, var(--accent) 18%, transparent)"
    />
    <div
      class="absolute right-10 top-10 w-24 h-24 rotate-45 border-2 opacity-40"
      style="border-color: color-mix(in srgb, var(--accent) 50%, transparent)"
    />
    <div
      class="absolute left-12 bottom-12 w-12 h-12 rotate-45 border opacity-50"
      style="border-color: color-mix(in srgb, var(--accent-secondary) 55%, transparent)"
    />
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(var(--border) 1px, transparent 1px); background-size: 26px 26px;"
    />
  </div>

  <div class="relative max-w-3xl mx-auto px-6 md:px-10 py-16 md:py-24">
    <a
      href="/projects"
      class="inline-block mb-8 text-xs text-[var(--muted-foreground)] no-underline hover:text-[var(--text)] transition-colors"
    >&larr; Projects</a>

    <div
      class="frosted-overlay border p-8 md:p-12 backdrop-blur-xl"
      style="background: color-mix(in srgb, var(--surface) 55%, transparent); border-color: var(--border); box-shadow: var(--shadow-lg);"
    >
      <p class="text-[11px] font-bold tracking-[0.2em] uppercase mb-4 text-[var(--accent)]">What I did</p>
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[var(--text)] m-0">{title}</h1>
      <p class="text-sm mt-2 font-medium text-[var(--accent)]">{tagline}</p>
      <p class="text-sm leading-relaxed text-[var(--muted-foreground)] mt-5">{summary}</p>
      <div class="flex flex-wrap gap-2 mt-6">
        {tags.map(t => (
          <span class="text-xs font-medium px-2.5 py-1 border border-[var(--border)] text-[var(--muted-foreground)]">{t}</span>
        ))}
      </div>
      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-8 text-xs font-medium px-4 py-2 border border-[var(--border)] text-[var(--accent)] no-underline transition-colors hover:border-[var(--accent)]"
        >View on GitHub &rarr;</a>
      )}

      {features && features.length > 0 && (
        <div class="mt-10 pt-8 border-t border-[var(--border)]">
          <h2 class="text-xs font-bold tracking-[0.2em] uppercase text-[var(--muted-foreground)] mb-4">Features</h2>
          <ul class="m-0 pl-5 space-y-2">
            {features.map(f => (
              <li class="text-sm leading-relaxed text-[var(--muted-foreground)]">{f}</li>
            ))}
          </ul>
        </div>
      )}

      {workflow && workflow.length > 0 && (
        <div class="mt-10 pt-8 border-t border-[var(--border)]">
          <h2 class="text-xs font-bold tracking-[0.2em] uppercase text-[var(--muted-foreground)] mb-4">How it works</h2>
          <ol class="m-0 pl-5 space-y-2 list-decimal">
            {workflow.map(s => (
              <li class="text-sm leading-relaxed text-[var(--muted-foreground)]">{s}</li>
            ))}
          </ol>
        </div>
      )}

      {stack && stack.length > 0 && (
        <div class="mt-10 pt-8 border-t border-[var(--border)]">
          <h2 class="text-xs font-bold tracking-[0.2em] uppercase text-[var(--muted-foreground)] mb-4">Tech stack</h2>
          <ul class="m-0 space-y-2">
            {stack.map(s => {
              const i = s.indexOf(":");
              const layer = i >= 0 ? s.slice(0, i) : s;
              const items = i >= 0 ? s.slice(i + 1).trim() : "";
              return (
                <li class="text-sm leading-relaxed text-[var(--muted-foreground)]">
                  <span class="font-medium text-[var(--text)]">{layer}:</span>{" "}{items}
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>
