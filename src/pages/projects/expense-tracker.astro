---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectOverlay from "../../components/ProjectOverlay.astro";

const summary = `Designed and shipped Deneb end-to-end: a multi-agent Google ADK backend — five collaborating agents (root, saver, retriever, bank, visualizer) exposed through a Telegram bot on Cloud Run with MongoDB storage — and a Tauri 2 + Svelte 5 mobile app. I handled expense capture from text, photos, PDFs, and voice, natural-language querying of expenses, bank reconciliation, automated chart generation, and an iOS-style dashboard with biometric lock.`;
---

<BaseLayout title="Deneb | Steve Jevon Rahardjo" description="Full-stack personal finance tracker — Multi-agent ADK backend + Tauri/Svelte mobile app">
  <ProjectOverlay
    title="Deneb"
    tagline="Full-stack personal finance tracker — multi-agent AI backend meets a mobile-first Tauri app"
    summary={summary}
    tags={["Google ADK","Python","Tauri 2","Svelte 5","MongoDB","Telegram Bot","Cloud Run"]}
    github="https://github.com/steverahardjo/adk_exp_tracker"
  />
</BaseLayout>
