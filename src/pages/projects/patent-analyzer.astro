---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectOverlay from '../../components/ProjectOverlay.astro';

const summary = `Built an AI-powered patent analysis platform from scratch: a FastAPI backend that embeds and indexes patent documents in Qdrant for semantic search, answers questions via RAG with Cohere reranking, classifies documents with LLMs, and extracts TRIZ innovation principles — all wrapped in a React frontend and Dockerized for deployment.`;
---

<BaseLayout title="Patent Analyzer | Steve Jevon Rahardjo" description="AI-Powered Patent Document Analysis System using LLMs and RAG.">
  <ProjectOverlay
    title="Patent Analyzer"
    tagline="AI-powered patent document analysis with LLMs and RAG"
    summary={summary}
    tags={["Python","FastAPI","QdrantDB","RAG","LLMs","React","Docker"]}
    github="https://github.com/reneeyst23/patent-analyser-fyp"
  />
</BaseLayout>
