---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | Steve Jevon Rahardjo" description="CS graduate from Monash University Malaysia." page="about">
  <h1 class="text-2xl md:text-3xl font-bold tracking-tight mb-12">About</h1>

  <section class="mb-16 max-w-3xl">
    <p class="text-sm md:text-base leading-relaxed text-[var(--muted-foreground)] mb-5">CS graduate from <strong class="text-[var(--text)]">Monash University Malaysia</strong>, focused on backend systems and AI-centric development. I build side projects around network programming, database optimization, and practical LLM applications.</p>
    <p class="text-sm md:text-base leading-relaxed text-[var(--muted-foreground)]">Goal: ship scalable products with clean engineering.</p>
  </section>

  <section class="mb-16">
    <h3 class="eyebrow mb-5">Skills</h3>
    <div class="flex flex-wrap gap-1.5 mb-5" role="tablist" aria-label="Skills">
      {[["languages","Languages"],["aiml","AI/ML"],["data-tools","Data Tools"],["dev-tools","Dev Tools"]].map(([id,label],i) => (
        <button type="button" role="tab" id={`tab-${id}`} aria-selected={i===0?"true":"false"} aria-controls={`panel-${id}`} tabindex={i===0?0:-1} data-target={id}
          class="tab-btn text-xs font-medium px-3 py-1.5 border border-[var(--border)] bg-transparent text-[var(--muted-foreground)] cursor-pointer transition-colors duration-150 hover:border-[var(--accent)]/50 hover:text-[var(--text)] data-[active=true]:bg-[var(--accent)] data-[active=true]:text-white data-[active=true]:border-[var(--accent)]"
        >{label}</button>
      ))}
    </div>
    <div class="skill-panels">
      {[
        ["languages","Core languages",["Python","Java","Go","SQL","R","TypeScript"]],
        ["aiml","ML & retrieval",["LLMs","RAG","Google ADK","Hugging Face","Scikit-Learn","XGBoost"]],
        ["data-tools","Streaming & analytics",["PySpark","Kafka","MongoDB","QdrantDB","Pandas","Matplotlib"]],
        ["dev-tools","Build & delivery",["Git","Docker","GitHub Actions","Flask","BeautifulSoup"]],
      ].map(([id,sub,words],i) => (
        <div class="skill-panel border-t border-[var(--border)] pt-5" role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`} data-panel={id as string} hidden={i!==0}>
          <p class="font-mono text-xs text-[var(--muted-foreground)] mb-4">{sub as string}</p>
          <div class="flex flex-wrap gap-2">
            {(words as string[]).map(w => (
              <span class="font-mono text-xs px-3 py-1.5 border border-[var(--border)] text-[var(--text)]">{w}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16">
    <h3 class="eyebrow mb-6">Education</h3>
    <article class="border-l-2 border-[var(--border)] pl-5">
      <h4 class="text-base font-bold m-0">B.CompSci (Data Science)</h4>
      <p class="text-sm text-[var(--accent)] font-medium mt-1">Monash University Malaysia</p>
      <p class="font-mono text-xs text-[var(--muted-foreground)] mt-1.5">Feb 2023 &ndash; Nov 2025</p>
      <div class="flex flex-wrap gap-1.5 mt-4">
        {["Data Science","DSA","Data Modelling","Visualization","OOP","Warehousing","Big Data"].map(c => (
          <span class="font-mono text-[11px] px-2 py-0.5 border border-[var(--border)] text-[var(--muted-foreground)]">{c}</span>
        ))}
      </div>
    </article>
  </section>

  <section>
    <h3 class="eyebrow mb-6">Experience</h3>
    <div class="border-l-2 border-[var(--border)] pl-5 space-y-8">
      <article>
        <h4 class="text-base font-bold m-0">Data Analyst Trainee (CDP Team)</h4>
        <p class="text-sm text-[var(--accent)] font-medium mt-1">SynergyXYZ</p>
        <p class="font-mono text-xs text-[var(--muted-foreground)] mt-1.5">Nov 2024 &ndash; Feb 2025</p>
        <p class="text-xs mt-3 leading-relaxed text-[var(--muted-foreground)] max-w-[60ch]">Evaluated 20+ CDP vendors, led client research, authored SDK and workflow documentation.</p>
      </article>
      <article>
        <h4 class="text-base font-bold m-0">Website Admin (Volunteer)</h4>
        <p class="text-sm text-[var(--accent)] font-medium mt-1">PPI Monash Malaysia</p>
        <p class="font-mono text-xs text-[var(--muted-foreground)] mt-1.5">Jul 2024 &ndash; Nov 2025</p>
        <p class="text-xs mt-3 leading-relaxed text-[var(--muted-foreground)] max-w-[60ch]">WordPress revamp, content publishing, event coordination.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const tabs = Array.from(document.querySelectorAll(".tab-btn"));
  const panels = Array.from(document.querySelectorAll(".skill-panel"));

  function select(target) {
    tabs.forEach(b => {
      const on = b.dataset.target === target;
      b.dataset.active = on ? "true" : "false";
      b.setAttribute("aria-selected", on ? "true" : "false");
      b.tabIndex = on ? 0 : -1;
    });
    panels.forEach(p => {
      p.hidden = p.dataset.panel !== target;
    });
  }

  tabs.forEach(tab => {
    tab.addEventListener("click", () => {
      select(tab.dataset.target);
      tab.focus();
    });
    tab.addEventListener("keydown", e => {
      const i = tabs.indexOf(tab);
      let next = null;
      if (e.key === "ArrowRight") next = tabs[(i + 1) % tabs.length];
      else if (e.key === "ArrowLeft") next = tabs[(i - 1 + tabs.length) % tabs.length];
      else if (e.key === "Home") next = tabs[0];
      else if (e.key === "End") next = tabs[tabs.length - 1];
      if (next) {
        e.preventDefault();
        select(next.dataset.target);
        next.focus();
      }
    });
  });
</script>
