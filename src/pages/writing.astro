---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Writing | Steve Jevon Rahardjo" description="Blog posts on backend systems, AI, and data engineering." page="writing">
  <h1 class="text-2xl md:text-3xl font-bold tracking-tight mb-2">Writing</h1>
  <p class="text-sm text-[var(--muted-foreground)] mb-12">Notes on systems, AI, and engineering.</p>

  {posts.length > 0 ? (
    <ol class="border-t border-[var(--border)]">
      {posts.map(post => (
        <li class="border-b border-[var(--border)]">
          <a href={`/blog/${post.id}`} class="group grid grid-cols-1 md:grid-cols-[9rem_1fr] gap-x-8 gap-y-1 py-6 no-underline">
            <time class="font-mono text-xs text-[var(--muted-foreground)]">
              {new Date(post.data.pubDate).toLocaleDateString("en-US",{year:"numeric",month:"short",day:"numeric"})}
            </time>
            <div>
              <h3 class="m-0 text-base font-bold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors">{post.data.title}</h3>
              <p class="mt-1.5 text-xs text-[var(--muted-foreground)] leading-relaxed">{post.data.description}</p>
              <div class="flex flex-wrap gap-1.5 mt-3">
                {post.data.tags?.slice(0,3).map(t => <span class="font-mono text-[10px] px-2 py-0.5 border border-[var(--border)] text-[var(--muted-foreground)]">{t}</span>)}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <p class="text-xs text-[var(--muted-foreground)] py-12 text-center">Nothing here yet.</p>
  )}
</BaseLayout>
