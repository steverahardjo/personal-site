---
import JsonLd from "../components/JsonLd.astro";
import ThemePicker from "../components/ThemePicker";
import "../styles/tailwind.css";
import "../styles/style.css";

export interface Props {
  title: string;
  description?: string;
  page?: string;
}

const { title, description, page = "" } = Astro.props;
const currentYear = new Date().getFullYear();
const siteUrl = "https://sjrah.net";
const pageDescription = description || "Steve Jevon Rahardjo - building software.";
const ogImage = `${siteUrl}/og-image.png`;

const navItems = [
  { id: "home", href: "/", label: "Home" },
  { id: "about", href: "/about", label: "About" },
  { id: "projects", href: "/projects", label: "Projects" },
  { id: "writing", href: "/writing", label: "Writing" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={ogImage} />
    <title>{title}</title>
    <link rel="icon" href="/favicon-v2.svg" type="image/svg+xml" />
    <script>
      (function(){var t=localStorage.getItem("theme-palette")||"original";document.documentElement.setAttribute("data-theme",t);})();
    </script>
    <JsonLd
      name="Steve Jevon Rahardjo"
      jobTitle="Software Engineer"
      email="steve.jevon.r@gmail.com"
      github="https://github.com/steverahardjo"
      linkedin="https://linkedin.com/in/steve-jevon-rahardjo"
    />
  </head>
  <body class="min-h-[100dvh] bg-[var(--bg)]">
    <!-- Tab bar: fixed top, only the paper tabs show -->
    <header class="sticky top-0 z-40 bg-[var(--bg)]">
      <div class="max-w-2xl mx-auto px-6 pt-4">
        <div class="flex items-end">
          <!-- Name badge -->
          <a href="/" class="flex items-center gap-2 no-underline mr-4 mb-1 shrink-0">
            <img src="/favicon-v2.svg" alt="" class="w-4 h-4 opacity-70" />
            <span class="text-[11px] font-semibold tracking-tight text-[var(--muted-foreground)] hidden sm:inline">Steve Jevon Rahardjo</span>
          </a>

          <!-- Folder tab navigation -->
          <nav class="flex items-end gap-px overflow-x-auto">
            {navItems.map(({ id, href, label }) => (
              <a href={href}
                class={`relative shrink-0 px-4 pt-2 pb-2 text-[11px] font-semibold tracking-wide uppercase no-underline transition-colors duration-150 border border-b-0 border-[var(--border)] ${
                  page === id
                    ? "bg-[var(--surface)] text-[var(--accent)] z-10 rounded-t-md"
                    : "bg-[var(--surface-low)] text-[var(--muted-foreground)] hover:text-[var(--text)] rounded-t-md"
                }`}
              >
                {label}
              </a>
            ))}
          </nav>

          <!-- Resume tab (file action) -->
          <a href="/resume.pdf" target="_blank" rel="noopener noreferrer"
            class="shrink-0 px-4 pt-2 pb-2 text-[11px] font-semibold tracking-wide uppercase no-underline transition-colors duration-150 bg-[var(--surface-low)] text-[var(--muted-foreground)] hover:text-[var(--text)] border border-b-0 border-[var(--border)] rounded-t-md ml-auto">
            Resume
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-2xl mx-auto px-6 py-12 md:py-20 bg-[var(--surface)] border-x border-b border-[var(--border)]">
      <slot />
    </main>

    <footer class="border-t border-[var(--border)]">
      <div class="max-w-4xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4 text-[var(--muted-foreground)]">
          <a href="https://github.com/steverahardjo" target="_blank" rel="noopener" aria-label="GitHub" class="hover:text-[var(--accent)] transition-colors">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://linkedin.com/in/steve-jevon-rahardjo" target="_blank" rel="noopener" aria-label="LinkedIn" class="hover:text-[var(--accent)] transition-colors">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <a href="mailto:steve.jevon.r@gmail.com" aria-label="Email" class="hover:text-[var(--accent)] transition-colors">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M0 3v18h24v-18h-24zm21.518 2l-9.518 7.713-9.518-7.713h19.036zm-19.518 14v-11.817l10 8.104 10-8.104v11.817h-20z"/></svg>
          </a>
        </div>
        <p class="text-xs text-[var(--muted-foreground)]">&copy; {currentYear} Steve Jevon Rahardjo</p>
      </div>
    </footer>

    <ThemePicker client:load />
    <script src="/script.js" defer></script>
  </body>
</html>
