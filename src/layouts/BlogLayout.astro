---
import BaseLayout from "./BaseLayout.astro";

export interface Props { title: string; description?: string; pubDate: Date; tags?: string[]; }

const { title, description, pubDate, tags = [] } = Astro.props;
const date = new Date(pubDate).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={`${title} | Steve Rahardjo`} description={description} page="writing">
  <article class="max-w-3xl">
    <header class="mb-12">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight m-0">{title}</h1>
      <div class="flex items-center gap-3 mt-3 flex-wrap">
        <time class="text-xs text-[var(--muted-foreground)]" datetime={pubDate.toISOString()}>{date}</time>
        {tags.map(t => <span class="text-[11px] font-medium px-2 py-0.5 border border-[var(--border)] text-[var(--muted-foreground)]">{t}</span>)}
      </div>
    </header>

    <div class="prose-custom text-base leading-[1.8] 
      [&_h2]:text-xl [&_h2]:font-bold [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:tracking-tight
      [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:mt-10 [&_h3]:mb-3
      [&_h4]:text-base [&_h4]:font-semibold [&_h4]:mt-8 [&_h4]:mb-2
      [&_p]:mb-5
      [&_strong]:font-bold [&_strong]:text-[var(--text)]
      [&_b]:font-bold
      [&_em]:italic
      [&_ul]:mb-5 [&_ul]:pl-5 [&_ul]:list-disc
      [&_ol]:mb-5 [&_ol]:pl-5 [&_ol]:list-decimal
      [&_li]:mb-1.5
      [&_li>p]:inline
      [&_blockquote]:border-l-[3px] [&_blockquote]:border-[var(--accent)] [&_blockquote]:pl-5 [&_blockquote]:my-6 [&_blockquote]:italic [&_blockquote]:text-[var(--muted-foreground)]
      [&_a]:text-[var(--accent)] [&_a]:no-underline [&_a]:font-medium [&_a:hover]:underline
      [&_code]:text-[0.875em] [&_code]:bg-[var(--surface-low)] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:font-mono
      [&_pre]:border [&_pre]:border-[var(--border)] [&_pre]:p-5 [&_pre]:overflow-x-auto [&_pre]:mb-6 [&_pre]:text-sm [&_pre]:leading-relaxed
      [&_pre_code]:bg-transparent [&_pre_code]:p-0
      [&_table]:w-full [&_table]:border-collapse [&_table]:mb-6 [&_table]:text-sm
      [&_th]:border [&_th]:border-[var(--border)] [&_th]:p-2.5 [&_th]:text-left [&_th]:font-semibold [&_th]:bg-[var(--surface-low)]
      [&_td]:border [&_td]:border-[var(--border)] [&_td]:p-2.5
      [&_img]:rounded-lg [&_img]:max-w-full [&_img]:my-6
      [&_hr]:border-[var(--border)] [&_hr]:my-8
      [&_.mermaid]:bg-transparent [&_.mermaid]:flex [&_.mermaid]:justify-center
      [&_.typst-rendered]:bg-transparent [&_.typst-rendered]:flex [&_.typst-rendered]:justify-center [&_.typst-rendered]:my-6
      [&_.typst-error]:text-xs [&_.typst-error]:text-red-500 [&_.typst-error]:p-3 [&_.typst-error]:border [&_.typst-error]:border-red-500/30 [&_.typst-error]:rounded [&_.typst-error]:mb-4
    ">
      <slot />
    </div>
    <a href="/writing" class="inline-block mt-12 text-xs text-[var(--muted-foreground)] no-underline hover:text-[var(--text)] transition-colors">&larr; Back to Writing</a>
  </article>
</BaseLayout>

<script is:inline>
  // ── Copy button ──────────────────────────────────
  document.querySelectorAll("pre").forEach(pre => {
    const wrap = document.createElement("div");
    wrap.className = "relative group";
    pre.parentNode.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    const lang = pre.querySelector("code")?.className.match(/language-(\w+)/)?.[1];
    if (lang) {
      const label = document.createElement("span");
      label.className = "absolute top-2 left-3 text-[10px] font-mono font-semibold tracking-wider uppercase text-[var(--muted-foreground)] opacity-60";
      label.textContent = lang;
      wrap.appendChild(label);
    }

    const btn = document.createElement("button");
    btn.className = "absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-[11px] font-mono font-medium px-2 py-1 rounded border border-[var(--border)] bg-[var(--surface)] text-[var(--muted-foreground)] hover:text-[var(--accent)] cursor-pointer";
    btn.textContent = "copy";
    btn.setAttribute("aria-label", "Copy code");
    wrap.appendChild(btn);

    btn.addEventListener("click", async () => {
      const code = pre.querySelector("code") || pre;
      try {
        await navigator.clipboard.writeText(code.textContent || pre.textContent || "");
        btn.textContent = "copied!";
        setTimeout(() => { btn.textContent = "copy"; }, 1500);
      } catch { btn.textContent = "failed"; }
    });
  });

  // ── Mermaid rendering ────────────────────────────
  const mermaidBlocks = document.querySelectorAll("pre code.language-mermaid");
  if (mermaidBlocks.length > 0) {
    const script = document.createElement("script");
    script.src = "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js";
    script.onload = async () => {
      mermaidBlocks.forEach(async (code, i) => {
        const container = code.closest('.relative.group') || code.parentElement;
        const wrap = document.createElement("div");
        wrap.className = "mermaid my-6 flex justify-center";
        wrap.id = `mermaid-${i}`;
        container.replaceWith(wrap);
        try {
          const { svg } = await mermaid.render(`mermaid-diag-${i}`, code.textContent.trim());
          wrap.innerHTML = svg;
        } catch (e) {
          wrap.innerHTML = `<p class="typst-error">Mermaid error: ${e.message}</p>`;
        }
      });
    };
    document.head.appendChild(script);
  }

  // ── Typst rendering ──────────────────────────────
  const typstBlocks = document.querySelectorAll("pre code.language-typst");
  if (typstBlocks.length > 0) {
    const script = document.createElement("script");
    script.type = "module";
    script.textContent = `
      import { TypstRenderer } from "https://cdn.jsdelivr.net/npm/@myriaddreamin/typst.ts@0.5.5/dist/esm/renderer.mjs";
      const renderer = new TypstRenderer();
      await renderer.init();
      const blocks = document.querySelectorAll("pre code.language-typst");
      for (const code of blocks) {
        const container = code.closest('.relative.group') || code.parentElement;
        const wrap = document.createElement("div");
        wrap.className = "typst-rendered";
        container.replaceWith(wrap);
        try {
          const svg = renderer.renderToString({ content: code.textContent.trim() });
          wrap.innerHTML = svg;
        } catch (e) {
          wrap.innerHTML = '<p class="typst-error">Typst error: ' + e.message + '</p>';
        }
      }
    `;
    document.head.appendChild(script);
  }
</script>
